<Window x:Class="Celeris.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Celeris" Width="1280" Height="800" MinWidth="760" MinHeight="500" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextBrush}" KeyDown="OnKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#74BDF0"/><SolidColorBrush x:Key="PrimaryDarkBrush" Color="#56A9E6"/><SolidColorBrush x:Key="AccentBrush" Color="#F7C85C"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="TabChrome" Background="{TemplateBinding Background}" CornerRadius="9,9,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="6,2"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="OptionsButton" Content="•••" ToolTip="Opções" Click="Options_Click"><Button.ContextMenu><ContextMenu><MenuItem Header="Nova sessão" Click="NewSession_Click"/><Separator/><MenuItem Header="Tema"><MenuItem Header="Usar tema do sistema" Click="SystemTheme_Click"/><MenuItem Header="Tema claro" Click="LightTheme_Click"/><MenuItem Header="Tema escuro" Click="DarkTheme_Click"/></MenuItem><Separator/><MenuItem Header="Copiar endereço" Click="CopyAddress_Click"/><MenuItem x:Name="ToggleAddressMenuItem" Header="Exibir endereço" Click="ToggleAddress_Click"/><MenuItem Header="Tela cheia" Click="ToggleFullScreen_Click"/><Separator/><MenuItem Header="Recarregar página" Click="Reload_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel>
   <Border x:Name="LogoHost" Width="60" Margin="0" VerticalAlignment="Center" DockPanel.Dock="Left"/><Button x:Name="BackButton" ToolTip="Voltar" Click="Back_Click" Visibility="Collapsed"><Path Data="M15 18 L9 12 L15 6" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Width="17" Height="17" Stretch="Uniform"/></Button><Button x:Name="ForwardButton" ToolTip="Avançar" Click="Forward_Click" Visibility="Collapsed"><Path Data="M9 18 L15 12 L9 6" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Width="17" Height="17" Stretch="Uniform"/></Button><Button ToolTip="Recarregar" Click="Reload_Click"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="16"/></Button>
   <Button ToolTip="Voltar ao início" Click="Home_Click"><StackPanel Orientation="Horizontal"><Path Data="M3 10.5 L12 3 L21 10.5 M5 9 V21 H19 V9 M9 21 V14 H15 V21" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Início" Margin="5,0,0,0"/></StackPanel></Button><Button ToolTip="Abrir guia de pesquisa" Click="Research_Click"><StackPanel Orientation="Horizontal"><Path Data="M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 M2 12 H22 M12 2 C15 5 16 8 16 12 C16 16 15 19 12 22 M12 2 C9 5 8 8 8 12 C8 16 9 19 12 22" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Pesquisar" Margin="5,0,0,0"/></StackPanel></Button><StackPanel x:Name="FavoritesPanel" Orientation="Horizontal"/></DockPanel></Border>
  <Border Grid.Row="1" Background="{DynamicResource AppBackground}" Padding="0" Margin="0"><Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button ToolTip="Nova aba" Padding="0" Click="NewTab_Click"><Path Data="M12 5 V19 M5 12 H19" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Width="17" Height="17" Stretch="Uniform"/></Button><ScrollViewer x:Name="TabScroller" Grid.Column="1" Margin="0" Padding="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScroller_MouseWheel"><ListBox x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectionChanged="Tabs_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" Margin="0"><ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.ContextMenu><ContextMenu><MenuItem Header="Duplicar guia" Tag="{Binding}" Click="DuplicateTab_Click"/></ContextMenu></StackPanel.ContextMenu><Border Width="7" Height="7" CornerRadius="4" Margin="0,0,6,0" Background="{Binding Session.Color}"/><TextBlock Text="{Binding Title}" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Content="×" Padding="5,0" Margin="3,0,0,0" Tag="{Binding}" Click="CloseTab_Click"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></ScrollViewer></Grid></Border>
  <Border x:Name="AddressBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,0"><TextBox x:Name="AddressText" Height="22" FontSize="11" VerticalContentAlignment="Center" IsReadOnly="False" KeyDown="AddressText_KeyDown" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"/></Border>
  <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True"><Grid x:Name="BrowserHost"/></Border>
 </Grid>
</Window>
